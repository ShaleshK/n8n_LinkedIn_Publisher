    {
      "parameters": {
        "jsCode": "// Grab the parsed form body from the webhook (n8n auto-parses\n// application/x-www-form-urlencoded content into $json.body)\nconst items = $input.all();\nconst body = items[0]?.json?.body || {};\nconst stringifiedPayload = body.payload;\n\nif (!stringifiedPayload) {\n    throw new Error(\"Could not find 'payload' in the Slack form submission. Check that Slack's Request URL points at this webhook's production URL.\");\n}\n\n// Parse the underlying Slack interactive JSON payload\nconst parsedPayload = JSON.parse(stringifiedPayload);\n\n// blocks[0] is the text \"Proposed Copy\" section.\n// blocks[1] is the actions block (the buttons) and has no .text field.\nconst fullText = parsedPayload.message?.blocks?.[0]?.text?.text || \"\";\n\nconst copyMarker = \"*Proposed Copy:* \\n\";\nconst confidenceMarker = \"*Confidence Score:*\";\n\nconst copyIdx = fullText.indexOf(copyMarker);\nconst confidenceIdx = fullText.indexOf(confidenceMarker);\n\n// Extract post text, stopping before the confidence line if present\nlet postText = \"\";\nif (copyIdx !== -1) {\n    const start = copyIdx + copyMarker.length;\n    const end = confidenceIdx !== -1 ? confidenceIdx : fullText.length;\n    postText = fullText.slice(start, end).trim();\n} else {\n    postText = fullText.trim();\n}\n\n// Extract confidence score from after its marker\nlet confidenceScore = null;\nif (confidenceIdx !== -1) {\n    const rawValue = fullText.slice(confidenceIdx + confidenceMarker.length).trim();\n    const parsed = parseFloat(rawValue);\n    confidenceScore = isNaN(parsed) ? null : parsed;\n}\n\nreturn {\n    body: parsedPayload,\n    post_text: postText,\n    confidence_score: confidenceScore,\n    action_value: parsedPayload.actions?.[0]?.value || \"\"\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        256
      ],
      "id": "fe349063-63e2-415d-893c-225a0822d5bc",
      "name": "Parse Slack Approval Payload"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.post_text || $input.item.json.final_post_text;\n\nif (!text) {\n  throw new Error(\"No post text found in input data (checked post_text and final_post_text).\");\n}\n\nconst origin = $input.item.json.post_text ? \"slack_approved\" : \"auto_published\";\n\nconst body = {\n  author: \"urn:li:person:YOUR_REAL_ID_HERE\",\n  commentary: text,\n  visibility: \"PUBLIC\",\n  distribution: { feedDistribution: \"MAIN_FEED\" },\n  lifecycleState: \"PUBLISHED\"\n};\n\nreturn {\n  ...$input.item.json,\n  origin,\n  linkedin_body_json: JSON.stringify(body)\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
